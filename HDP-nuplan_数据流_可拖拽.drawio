        <mxCell id="tp" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d6f5d6;strokeColor=#4a9a4a;" value="◄输入← args(CLI) + path_list.json&#xa;►输出→ train_epoch 调用 + ckpt(.pth) + args.json&#xa;train_predictor.model_training:109&#xa;ddp + DataLoader + Diffusion_Planner→DDP + ModelEma(0.999) + AdamW(5e-4) + CosineWarmup&#xa;⚠ args: diffusion_model_type=x_start, diffusion_supervision_type=x_start, planning_hybrid_loss=0.01" vertex="1">
          <mxGeometry height="120" width="400" x="850" y="100" as="geometry" />
