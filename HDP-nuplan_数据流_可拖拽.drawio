        </mxCell>
        <mxCell id="e67" value="trajectory[80,3]" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=9;" edge="1" parent="1" source="traj" target="pl">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="lg2" value="HDP 推理特性（vs DP）:&#xa;① xT = randn(1,80,4)*0.1（非 randn*0.5 + anchor 拼接）&#xa;② dpm_sampler 无 correcting_xt_fn（无 anchor 约束）、无 classifier_fn（无引导）&#xa;③ cumsum(x0[...,:2]) 重积分速度→位置（DP 是直接输出 waypoint）&#xa;④ ego-only output[1,80,4]（非[1,11,80,4] ego+邻居）" style="text;html=1;align=left;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="40" y="900" width="700" height="80" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
