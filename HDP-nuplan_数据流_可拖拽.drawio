        <mxCell id="e40" edge="1" parent="1" source="total" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=9;" target="back" value="loss dict">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="lg" parent="1" style="text;html=1;align=left;fontSize=11;" value="HDP-nuplan 特性（vs DP）:&#xa;① ego-only [B,80,4]（无邻居预测，无 anchor 帧）&#xa;② 速度表征: ego_future_vel=diff(zero_pad⊕ego_future) → [B,80,4](Δx,Δy,cos,sin)&#xa;③ 4目标 SDE.transform:129（x_start/noise/v/score ε-枢纽互转）&#xa;④ 混合损失: ego_planning + 0.01*hybrid(detached_integral:3, W=10)&#xa;⑤ DiT 80 timestep token×4dim(非11 agent×324); Embedding(80) per-timestep; ego_state_proj(2→192) 注入 vx,vy; 9*dim adaLN 全门控; 无 attn_mask&#xa;⑥ RouteEncoder 保留（encoder→decoder→DiT y）&#xa;⑦ 推理: 无 anchor/guidance, 噪声0.1, cumsum 重积分&#xa;⑧ StateNormalizer ego-only" vertex="1">
          <mxGeometry height="160" width="700" x="50" y="1180" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram name="推理" id="hdp_infer">
    <mxGraphModel dx="1800" dy="1400" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1300" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="t2" value="HDP-nuplan 推理数据流（HyperDiffusionPlanner → 无 anchor 无引导 → DPM-Solver 10步 → cumsum 重积分 → 轨迹）" style="text;html=1;align=center;fontSize=16;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="200" y="10" width="1300" height="30" as="geometry" />
        </mxCell>
        <mxCell id="pl" value="◄输入← nuPlan PlannerInput（仿真引擎每步调）&#xa;►输出→ InterpolatedTrajectory[80,3]（8s 轨迹）&#xa;HyperDiffusionPlanner.compute_planner_trajectory:117 (planner.py:28)&#xa;内部串: observation_adapter → normalize → model → decoder eval → dpm_sampler → inverse → cumsum → outputs_to_trajectory" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3e6f3;strokeColor=#8a3c8a;" vertex="1" parent="1">
          <mxGeometry x="500" y="70" width="500" height="120" as="geometry" />
        </mxCell>
        <mxCell id="obs" value="◄输入← PlannerInput.history_buffer + traffic_light + map_api + route_ids&#xa;►输出→ inputs dict(tensor, ego-centric)&#xa;data_processor.observation_adapter:38（复用 DP 预处理：agent_past_process + route_correction + map_process + convert_to_model_inputs）&#xa;⚠ ego_current=[0,0,1,0,...]，无 ego/邻居未来" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dbeeff;strokeColor=#5a86b8;" vertex="1" parent="1">
          <mxGeometry x="100" y="250" width="440" height="120" as="geometry" />
        </mxCell>
        <mxCell id="nm" value="◄输入← inputs dict(tensor)&#xa;►输出→ 归一化 inputs(padding 留0)&#xa;ObservationNormalizer.__call__:49" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e3f7e3;strokeColor=#4a9a4a;" vertex="1" parent="1">
          <mxGeometry x="650" y="270" width="240" height="80" as="geometry" />
        </mxCell>
        <mxCell id="e60" style="edgeStyle=orthogonalEdgeStyle;html=1;" edge="1" parent="1" source="pl" target="obs">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e61" style="edgeStyle=orthogonalEdgeStyle;html=1;" edge="1" parent="1" source="obs" target="nm">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="model" value="◄输入← inputs dict[归一化] (B=1)&#xa;►输出→ decoder_outputs{&#39;prediction&#39;:[1,80,4]}&#xa;Diffusion_Planner.forward:20&#xa;→ Encoder.forward(encoding[1,107,192]) + Decoder.forward:41(eval 分支)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff1b3;strokeColor=#9c8a1f;" vertex="1" parent="1">
          <mxGeometry x="950" y="250" width="400" height="100" as="geometry" />
        </mxCell>
        <mxCell id="e62" style="edgeStyle=orthogonalEdgeStyle;html=1;" edge="1" parent="1" source="nm" target="model">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="dec_eval" value="◄输入← encoding[1,107,192] + inputs{ego_current_state[1,10], route_lanes[1,25,20,12], ...}&#xa;►输出→ {&#39;prediction&#39;:[1,80,4]}&#xa;Decoder.forward:41 (eval 分支, decoder.py:41)&#xa;xT = randn(1, 80, 4) * 0.1 :95  ← ⚠噪声0.1(非0.5), 无 anchor 帧拼接&#xa;x0 = dpm_sampler(self.dit, xT, ...) :97  ← ⚠无 correcting_xt_fn(无 anchor), 无 classifier_fn(无引导)&#xa;x0 = state_normalizer.inverse(x0) :108 → [1,80,4](反归一化速度)&#xa;x0 = cat([cumsum(x0[...,:2],dim=-2), x0[...,2:]], -1) :110 → [1,80,4](速度→位置)&#xa;return {&#39;prediction&#39;: x0} :114" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff1b3;strokeColor=#9c8a1f;" vertex="1" parent="1">
          <mxGeometry x="500" y="430" width="520" height="200" as="geometry" />
        </mxCell>
        <mxCell id="e63" style="edgeStyle=orthogonalEdgeStyle;html=1;" edge="1" parent="1" source="model" target="dec_eval">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="dpm" value="◄输入← (model=DiT, x_T[1,80,4], other_model_params={cross_c[1,107,192], route_lanes, ego_current_states}, steps=10)&#xa;►输出→ x0[1,80,4] (τ₀ 干净速度)&#xa;dpm_sampler:6 (sampling.py)&#xa;NoiseScheduleVP(linear) + model_wrapper + DPM_Solver.sample&#xa;⚠ dpm_solver_params={}(空！无 correcting_xt_fn)&#xa;⚠ model_wrapper_params={}(空！无 classifier_fn, guidance_type=uncond)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe9d6;strokeColor=#b56a30;" vertex="1" parent="1">
          <mxGeometry x="1100" y="430" width="440" height="160" as="geometry" />
        </mxCell>
        <mxCell id="e64" value="xT[1,80,4]" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=9;" edge="1" parent="1" source="dec_eval" target="dpm">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e65" value="x0[1,80,4]" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=9;" edge="1" parent="1" source="dpm" target="dec_eval">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="traj" value="◄输入← outputs[&#39;prediction&#39;][1,80,4]&#xa;►输出→ InterpolatedTrajectory[80,3]&#xa;outputs_to_trajectory:107 (planner.py)&#xa;predictions = outputs[&#39;prediction&#39;][0,0] → [80,4]&#xa;heading = arctan2(pred[:,3], pred[:,2]) → [80,1]&#xa;predictions = cat([pred[:,:2], heading]) → [80,3] = (x,y,heading)&#xa;states = transform_predictions_to_states(predictions, ego_history, horizon=8s, step=0.1s)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3e6f3;strokeColor=#8a3c8a;" vertex="1" parent="1">
          <mxGeometry x="500" y="700" width="520" height="160" as="geometry" />
        </mxCell>
