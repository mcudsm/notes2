        <mxCell id="traj" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3e6f3;strokeColor=#8a3c8a;" value="◄输入← outputs[&#39;prediction&#39;][1,80,4]&#xa;►输出→ InterpolatedTrajectory[80,3]&#xa;outputs_to_trajectory:107 (planner.py)&#xa;predictions = outputs[&#39;prediction&#39;][0,0] → [80,4]&#xa;heading = arctan2(pred[:,3], pred[:,2]) → [80,1]&#xa;predictions = cat([pred[:,:2], heading]) → [80,3] = (x,y,heading)&#xa;states = transform_predictions_to_states(predictions, ego_history, horizon=8s, step=0.1s)" vertex="1">
