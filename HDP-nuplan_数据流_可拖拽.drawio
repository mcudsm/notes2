        </mxCell>
        <mxCell id="back" parent="1" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666;" value="backward" vertex="1">
          <mxGeometry height="50" width="120" x="1500" y="575" as="geometry" />
