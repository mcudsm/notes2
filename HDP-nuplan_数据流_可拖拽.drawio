        <mxCell id="e33" edge="1" parent="1" source="enc" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=9;" target="dec" value="encoding [B,107,192] (cross_c)">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e34" edge="1" parent="1" source="dec" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=9;" target="dit" value="x[B,80,4]+t+cross_c+route_lanes+ego_v">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e35" edge="1" parent="1" source="dit" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=9;" target="dec" value="score [B,80,4]">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e36" edge="1" parent="1" source="dec" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=9;" target="loss" value="score [B,80,4]">
