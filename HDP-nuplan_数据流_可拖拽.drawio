        <mxCell id="npz" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dbeeff;strokeColor=#5a86b8;" value="◄输入← nuPlan scenario（data_process 预处理，与 DP 同）&#xa;►输出→ .npz + path_list.json&#xa;.npz keys: ego_current[10] ego_future[80,3]&#xa;  neighbor_past[32,21,11] neighbor_future[32,80,3]&#xa;  lanes[70,20,12] route_lanes[25,20,12] static[5,10]" vertex="1">
