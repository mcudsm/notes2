        <mxCell id="1" parent="0" />
        <mxCell id="t2" value="Diffusion-Planner_aw 推理数据流（eval：validate_model → _forward_inference → 两条采样分支）" style="text;html=1;align=center;fontSize=16;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="200" y="10" width="1100" height="30" as="geometry" />
