        </mxCell>
        <mxCell id="e60" style="edgeStyle=orthogonalEdgeStyle;html=1;" edge="1" parent="1" source="vm" target="fi">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <!-- 分支 A: x_start (dpm_sampler) -->
        <mxCell id="ixs" value="◄输入← fi:728 (DiT, xT, cross_c, route_lanes, mask)&#xa;►输出→ x0 [1,33,80,4]&#xa;Decoder._inference_x_start:642&#xa;xT=zeros + prefix_mask + anchor 约束 + 可选 classifier guidance" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff1b3;strokeColor=#9c8a1f;" vertex="1" parent="1">
          <mxGeometry x="120" y="360" width="340" height="110" as="geometry" />
        </mxCell>
        <mxCell id="samp" value="◄输入← ixs:642 (DiT, xT, params)&#xa;►输出→ x0 [1,33,80,4]&#xa;sampling.dpm_sampler:6&#xa;10 步 DPM-Solver++ 去噪" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe9d6;strokeColor=#b56a30;" vertex="1" parent="1">
          <mxGeometry x="120" y="520" width="340" height="90" as="geometry" />
        </mxCell>
        <mxCell id="dpm" value="◄输入← samp:6&#xa;►输出→ sample x0&#xa;dpm_solver_pytorch: NoiseScheduleVP / model_wrapper:168 / DPM_Solver.sample:1047&#xa;内部用 DiT 作 model_fn" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe9d6;strokeColor=#b56a30;" vertex="1" parent="1">
          <mxGeometry x="120" y="650" width="340" height="100" as="geometry" />
        </mxCell>
        <mxCell id="e61" style="edgeStyle=orthogonalEdgeStyle;html=1;" edge="1" parent="1" source="fi" target="ixs">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e62" value="xT" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=9;" edge="1" parent="1" source="ixs" target="samp">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e63" style="edgeStyle=orthogonalEdgeStyle;html=1;" edge="1" parent="1" source="samp" target="dpm">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e64" value="x0" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=9;" edge="1" parent="1" source="dpm" target="samp">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <!-- 分支 B: flow_matching (ode) -->
        <mxCell id="ifm" value="◄输入← fi:728 (DiT, xT, cross_c, ...)&#xa;►输出→ x0 [1,33,80,4]&#xa;Decoder._inference_flow_matching:601&#xa;ODE 积分（与扩散并行的另一条生成路径）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff1b3;strokeColor=#9c8a1f;" vertex="1" parent="1">
          <mxGeometry x="1000" y="360" width="340" height="110" as="geometry" />
        </mxCell>
        <mxCell id="ode" value="◄输入← ifm:601 (velocity_field, x, steps)&#xa;►输出→ x&#xa;flow_matching_utils.ode_solver.euler_integration:4&#xa;Euler/Heun/RK4 积分速度场" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe9d6;strokeColor=#b56a30;" vertex="1" parent="1">
          <mxGeometry x="1000" y="520" width="340" height="90" as="geometry" />
