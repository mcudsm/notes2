        </mxCell>
        <!-- 图例 -->
        <mxCell id="lg2" value="颜色: 蓝=data_process / 绿=utils / 紫=loss / 橙=diffusion_utils / 黄=model / 粉=valid_predictor&#xa;每个框顶部: ◄输入来自谁 / ►输出去向谁 + 函数:行号 + 维度" style="text;html=1;align=left;fontSize=11;" vertex="1" parent="1">
