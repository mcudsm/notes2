        <!-- 入口 -->
        <mxCell id="vm" value="◄输入← val_loader（.npz）&#xa;►输出→ prediction + turn_indicator_logit&#xa;valid_predictor.validate_model:28&#xa;xT=zeros, delay=0 → 模型 → valid_loss_ego" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3e6f3;strokeColor=#8a3c8a;" vertex="1" parent="1">
          <mxGeometry x="560" y="70" width="340" height="90" as="geometry" />
        </mxCell>
        <!-- decoder 分发 -->
        <mxCell id="fi" value="◄输入← vm:28 inputs&#xa;►输出→ _inference_x_start / _inference_flow_matching&#xa;Decoder._forward_inference:728&#xa;reshape + 按 model_type 分发" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff1b3;strokeColor=#9c8a1f;" vertex="1" parent="1">
