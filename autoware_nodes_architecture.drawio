  <diagram id="planning" name="Planning 细化">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" page="1" pageWidth="1600" pageHeight="1000">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="pt" value="Planning 节点与交互" style="text;html=1;strokeColor=none;fillColor=none;fontSize=24;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="40" y="25" width="500" height="40" as="geometry" />
        </mxCell>
        <mxCell id="mission" value="Mission Planning&#xa;MissionPlanner：接收起终点/路线请求，维护任务状态&#xa;RouteSelector：从规划路线中选择当前可执行 route" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=14;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="50" y="150" width="320" height="130" as="geometry" />
        </mxCell>
        <mxCell id="scenario" value="Scenario Planning&#xa;ScenarioSelector：选择 Lane Driving / Parking 等场景&#xa;VelocitySmoother：平滑速度并施加外部速度限制" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=14;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="460" y="150" width="320" height="130" as="geometry" />
        </mxCell>
        <mxCell id="behavior" value="Behavior Planning&#xa;BehaviorPathPlanner：基于车道、障碍物和交通规则生成路径&#xa;BehaviorVelocityPlanner：在路口、横穿道、停止线等处调整速度" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=14;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="870" y="150" width="330" height="130" as="geometry" />
        </mxCell>
        <mxCell id="motion" value="Motion Planning&#xa;ElasticBandSmoother / PathOptimizer：平滑和优化路径&#xa;MotionVelocityPlanner：处理动态障碍、越界、减速/停车&#xa;输出候选 Trajectory" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=14;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="460" y="390" width="320" height="150" as="geometry" />
        </mxCell>
        <mxCell id="validator" value="Planning Validator&#xa;检查轨迹安全性、几何/动力学约束和延迟&#xa;通过后发布最终 Trajectory；异常时发布诊断/无效轨迹" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=14;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="870" y="400" width="330" height="130" as="geometry" />
        </mxCell>
        <mxCell id="pinput" value="输入&#xa;LaneletMapBin / Pose / Odometry&#xa;DetectedObjects / PredictedObjects&#xa;TrafficSignals / OccupancyGrid / Goal" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13" vertex="1" parent="1">
          <mxGeometry x="50" y="390" width="300" height="150" as="geometry" />
        </mxCell>
        <mxCell id="pout" value="输出&#xa;Trajectory（给 Control）&#xa;PathWithLaneId、RouteState&#xa;TurnIndicators / HazardLights / VelocityLimit" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=13;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="1260" y="390" width="260" height="150" as="geometry" />
        </mxCell>
        <mxCell id="pe1" value="LaneletRoute" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block" edge="1" parent="1" source="mission" target="scenario">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="pe2" value="Scenario" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block" edge="1" parent="1" source="scenario" target="behavior">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="pe3" value="Path" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block" edge="1" parent="1" source="behavior" target="motion">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="pe4" value="Trajectory" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block" edge="1" parent="1" source="motion" target="validator">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="pe5" value="Validated Trajectory" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeWidth=2" edge="1" parent="1" source="validator" target="pout">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="pe6" value="地图、定位、感知、信号" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;dashed=1;strokeColor=#6c8ebf" edge="1" parent="1" source="pinput" target="behavior">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="pe7" value="共享输入" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;dashed=1;strokeColor=#6c8ebf" edge="1" parent="1" source="pinput" target="motion">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="pe8" value="modified_goal / reroute_availability" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;dashed=1;strokeColor=#9673a6" edge="1" parent="1" source="behavior" target="mission">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="pn" value="核心交互：Mission 输出 route；Behavior 将 route 和环境状态转成 path；Motion 将 path 变成可执行 trajectory；Validator 负责质量闸门。" style="text;html=1;strokeColor=none;fillColor=none;fontSize=13;fontColor=#4b5563" vertex="1" parent="1">
          <mxGeometry x="50" y="700" width="1100" height="35" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="control" name="Control 细化">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" page="1" pageWidth="1600" pageHeight="1000">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="ct" value="Control 节点与交互" style="text;html=1;strokeColor=none;fillColor=none;fontSize=24;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="40" y="25" width="500" height="40" as="geometry" />
        </mxCell>
        <mxCell id="traj" value="TrajectoryFollower&#xa;接收 Planning Trajectory 与车辆状态&#xa;横向：MPC / Pure Pursuit；纵向：PID 等&#xa;输出 Control、PredictedTrajectory" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=14;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="370" y="150" width="350" height="150" as="geometry" />
        </mxCell>
        <mxCell id="shift" value="ShiftDecider&#xa;根据控制结果、当前挡位和车辆状态&#xa;决定 GearCommand" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=14;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="790" y="150" width="260" height="120" as="geometry" />
        </mxCell>
        <mxCell id="gate" value="VehicleCmdGate&#xa;自动 / 外部 / 紧急命令仲裁&#xa;结合 OperationMode、MRM、Engage、车辆状态&#xa;输出最终 control_cmd / gear / lights" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=14;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="1090" y="350" width="350" height="160" as="geometry" />
        </mxCell>
        <mxCell id="ext" value="ExternalCmdSelector + Converter&#xa;选择本地/远程外部控制源&#xa;转换为 Autoware 控制消息" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13" vertex="1" parent="1">
          <mxGeometry x="370" y="400" width="300" height="120" as="geometry" />
        </mxCell>
        <mxCell id="safety" value="安全与质量节点&#xa;ControlValidator：检查控制指令与轨迹一致性&#xa;AEB / CollisionDetector：碰撞风险与紧急制动&#xa;LaneDepartureChecker：车道偏离诊断" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=13;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="40" y="600" width="430" height="150" as="geometry" />
        </mxCell>
        <mxCell id="mode" value="OperationModeTransitionManager&#xa;管理手动/自动/远程/停止切换&#xa;向 VehicleCmdGate 下发 GateMode 和 Engage" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=13;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="560" y="600" width="350" height="130" as="geometry" />
        </mxCell>
        <mxCell id="vehicle2" value="Vehicle / Simulator&#xa;RawVehicleCmdConverter、CAN/ROS 接口&#xa;执行 Control / Gear / Indicators&#xa;反馈 Odometry、Steering、Velocity、Gear" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=14;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="1090" y="620" width="350" height="130" as="geometry" />
        </mxCell>
        <mxCell id="cin" value="Planning Trajectory&#xa;Odometry / Accel / Steering&#xa;OperationMode" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13" vertex="1" parent="1">
          <mxGeometry x="40" y="160" width="240" height="120" as="geometry" />
        </mxCell>
        <mxCell id="ce1" value="Trajectory + 状态" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block" edge="1" parent="1" source="cin" target="traj">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ce2" value="Control" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block" edge="1" parent="1" source="traj" target="shift">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ce3" value="Auto Control + Gear + Lights" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeWidth=2" edge="1" parent="1" source="shift" target="gate">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ce4" value="External Control" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block" edge="1" parent="1" source="ext" target="gate">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ce5" value="Final Vehicle Commands" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeWidth=2" edge="1" parent="1" source="gate" target="vehicle2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ce6" value="状态反馈" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;dashed=1;strokeColor=#666666" edge="1" parent="1" source="vehicle2" target="traj">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ce7" value="安全状态 / 紧急命令" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;dashed=1;strokeColor=#9673a6" edge="1" parent="1" source="safety" target="gate">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ce8" value="GateMode / Engage" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;dashed=1;strokeColor=#9673a6" edge="1" parent="1" source="mode" target="gate">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ce9" value="PredictedTrajectory / diagnostics" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;dashed=1;strokeColor=#9673a6" edge="1" parent="1" source="traj" target="safety">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="cn" value="核心交互：TrajectoryFollower 把规划结果闭环跟踪为控制量；VehicleCmdGate 是最终安全仲裁点；OperationMode、MRM 和碰撞检测可覆盖自动控制输出。" style="text;html=1;strokeColor=none;fillColor=none;fontSize=13;fontColor=#4b5563" vertex="1" parent="1">
          <mxGeometry x="40" y="830" width="1200" height="35" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="planningFull" name="Planning 节点全量">
    <mxGraphModel dx="1800" dy="1200" grid="1" gridSize="10" page="1" pageWidth="1800" pageHeight="1200">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="planningFullt" value="Planning 节点级细化（基于仓库实际 node.yaml）" style="text;html=1;strokeColor=none;fillColor=none;fontSize=22;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="30" y="20" width="900" height="35" as="geometry" />
        </mxCell>
        <mxCell id="planningFullmlane" value="① Mission / Route" style="swimlane;html=1;rounded=1;startSize=28;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;fontSize=14;horizontal=1" vertex="1" parent="1">
          <mxGeometry x="30" y="80" width="430" height="430" as="geometry" />
        </mxCell>
        <mxCell id="planningFullm0" value="MissionPlanner&#xa;autoware_mission_planner&#xa;作用：任务规划；接收 Goal/Route 请求，维护任务状态&#xa;Goal、Map、Pose → Route/RouteState" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;fontSize=10;verticalAlign=middle;spacing=5" vertex="1" parent="1">
          <mxGeometry x="45" y="118" width="195" height="92" as="geometry" />
        </mxCell>
        <mxCell id="planningFullm1" value="RouteSelector&#xa;autoware_mission_planner_universe&#xa;作用：从候选路线中选择当前执行路线&#xa;Mission Route → LaneletRoute" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;fontSize=10;verticalAlign=middle;spacing=5" vertex="1" parent="1">
          <mxGeometry x="250" y="118" width="195" height="92" as="geometry" />
        </mxCell>
        <mxCell id="planningFullm2" value="GoalPoseVisualizer&#xa;autoware_mission_planner&#xa;作用：任务目标可视化&#xa;Route → Markers" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;fontSize=10;verticalAlign=middle;spacing=5" vertex="1" parent="1">
          <mxGeometry x="45" y="218" width="195" height="92" as="geometry" />
        </mxCell>
        <mxCell id="planningFullm3" value="ManualLaneChangeHandler&#xa;autoware_manual_lane_change_handler&#xa;作用：处理外部手动变道请求&#xa;Route、Pose、Map → Lane Change" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;fontSize=10;verticalAlign=middle;spacing=5" vertex="1" parent="1">
          <mxGeometry x="250" y="218" width="195" height="92" as="geometry" />
        </mxCell>
        <mxCell id="planningFullslane" value="② Scenario / Common" style="swimlane;html=1;rounded=1;startSize=28;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1;fontSize=14;horizontal=1" vertex="1" parent="1">
