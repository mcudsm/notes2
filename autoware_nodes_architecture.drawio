        <mxCell id="ev1" value="启动入口&#xa;src/launcher/autoware_launch/autoware_launch/launch/autoware.launch.xml:17-26,68-137&#xa;Planning include&#xa;.../launch/components/tier4_planning_component.launch.xml:28-130&#xa;Control include&#xa;.../launch/components/tier4_control_component.launch.xml:29-67" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;spacing=5" vertex="1" parent="1">
          <mxGeometry x="40" y="110" width="720" height="250" as="geometry" />
        </mxCell>
        <mxCell id="ev2" value="Mission route chain&#xa;MissionPlanner.node.yaml:15-66&#xa;MissionPlanning.module.yaml:36-78&#xa;Routing API&#xa;src/core/autoware_core/api/autoware_default_adapi/src/routing.cpp:106-113,225-252&#xa;RouteSelector.node.yaml:15-69" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;spacing=5" vertex="1" parent="1">
          <mxGeometry x="820" y="110" width="720" height="250" as="geometry" />
        </mxCell>
        <mxCell id="ev3" value="本次纠错原则&#xa;1. Service、Topic、输入接口分开画。&#xa;2. 只有 module.yaml 明确连接的节点关系画实线。&#xa;3. 设计目录中存在但没有当前模块实例连接证据的节点，放入 Catalog 页并标记为“连接待确认”。&#xa;4. 不再把 MPC/PID/Pure Pursuit 等 package 名直接当作 Control.module.yaml 节点；它们是 TrajectoryFollower 的实现/参数模式。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;spacing=5" vertex="1" parent="1">
          <mxGeometry x="40" y="430" width="1500" height="180" as="geometry" />
        </mxCell>
        <mxCell id="ev4" value="源码确认 ≠ 推测：图中的实线代表配置/设计文件确认的关系；虚线代表辅助关系、模块输出到下游或需要进一步展开实现源码的关系。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;spacing=5" vertex="1" parent="1">
          <mxGeometry x="40" y="690" width="1500" height="100" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
